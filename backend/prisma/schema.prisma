datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int         @id @default(autoincrement())
  username   String
  password   String
  role       String      // "admin_space" or "member"
  
  spaceOwner SpaceOwner?
  member     Member?

  @@unique([username])
}

model SpaceOwner {
  id             Int     @id @default(autoincrement())
  nama_coworking String
  nama_pemilik   String
  telp           String
  id_user        Int     @unique
  user           User    @relation(fields: [id_user], references: [id], onDelete: Cascade)
  
  spaces         Space[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Member {
  id          Int      @id @default(autoincrement())
  nama_member String
  instansi    String?
  alamat      String?
  telp        String?
  foto        String?
  id_user     Int      @unique
  user        User     @relation(fields: [id_user], references: [id], onDelete: Cascade)

  reservasi   Reservasi[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Space {
  id            Int      @id @default(autoincrement())
  nama_space    String
  harga_per_jam Float
  tipe          String   // 'desk', 'meeting_room', 'private_office'
  kapasitas     Int
  foto          String?
  deskripsi     String?
  
  id_owner      Int
  owner         SpaceOwner @relation(fields: [id_owner], references: [id], onDelete: Cascade)
  
  reservasi     DetailReservasi[]
}

model Diskon {
  id                Int      @id @default(autoincrement())
  nama_diskon       String
  persentase_diskon Float
  tanggal_awal      DateTime
  tanggal_akhir     DateTime

  reservasi         DetailReservasi[]

  @@unique([nama_diskon])
}

model Reservasi {
  id                Int      @id @default(autoincrement())
  kode_booking      String   @unique
  tanggal_reservasi String   // e.g. "2026-08-30"
  jam_mulai         String   // e.g. "09:00"
  durasi_jam        Int
  status            String   @default("belum_dikonfirm")
  
  id_member         Int
  member            Member   @relation(fields: [id_member], references: [id], onDelete: Cascade)
  
  detail            DetailReservasi?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DetailReservasi {
  id                Int       @id @default(autoincrement())
  id_reservasi      Int       @unique
  reservasi         Reservasi @relation(fields: [id_reservasi], references: [id], onDelete: Cascade)
  
  id_space          Int
  space             Space     @relation(fields: [id_space], references: [id], onDelete: Cascade)
  
  id_diskon         Int?
  diskon            Diskon?   @relation(fields: [id_diskon], references: [id], onDelete: Cascade)
  
  total_harga_awal  Float
  potongan_diskon   Float
  total_bayar       Float
}
